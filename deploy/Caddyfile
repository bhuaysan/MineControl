# Caddy-Konfiguration für MineControl.
#
# - Liefert die gebaute SPA aus /srv aus (Client-seitiges Routing via try_files).
# - Proxyt /api und /ws an das Backend (Standard 127.0.0.1:3000).
# - Automatisches HTTPS:
#     * MC_SITE_ADDRESS=localhost  → Caddy stellt ein Zertifikat der lokalen
#       internen CA aus (Browser-Warnung, für LAN-Tests ok).
#     * MC_SITE_ADDRESS=mc.example.com → Caddy holt automatisch ein echtes
#       Let's-Encrypt-Zertifikat (Port 80/443 aus dem Internet erreichbar nötig).
{$MC_SITE_ADDRESS:localhost} {
	encode zstd gzip

	# API und WebSocket ans Backend weiterleiten.
	# WICHTIG: `handle`-Blöcke statt eines Matchers + `try_files`. Sonst schreibt
	# `try_files` (läuft in Caddys Direktiven-Reihenfolge VOR `reverse_proxy`)
	# jeden nicht existierenden Pfad — auch /api/* — auf /index.html um, sodass
	# der Proxy-Matcher nicht mehr greift und API-Requests im file_server landen.
	# `handle`-Blöcke sind gegenseitig exklusiv und in Definitionsreihenfolge.
	handle /api/* {
		reverse_proxy {$MC_UPSTREAM:127.0.0.1:3000}
	}
	handle /ws {
		reverse_proxy {$MC_UPSTREAM:127.0.0.1:3000}
	}
	handle /ws/* {
		reverse_proxy {$MC_UPSTREAM:127.0.0.1:3000}
	}

	# Alles andere: statische SPA-Dateien, sonst index.html (SPA-Fallback).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
