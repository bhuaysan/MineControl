# MineControl — Produktiv-Deployment (docker-compose).
# Kopieren nach `.env` und Werte setzen:  cp .env.example .env
#
# Dies ist die Umgebungsdatei für docker-compose. Die Entwicklungs-Variante
# liegt weiterhin unter apps/server/.env (nur für `pnpm dev`).

# --- Pflicht: Geheimnisse ---------------------------------------------------

# Signiert die Session-Cookies. Mind. 32 Zeichen, zufällig.
#   openssl rand -base64 48
SESSION_SECRET=""

# 32-Byte-Schlüssel (64 Hex-Zeichen) zum Verschlüsseln von RCON-Passwörtern
# und weiteren Secrets in der DB.  NICHT nachträglich ändern (macht die
# gespeicherten Secrets unlesbar).
#   openssl rand -hex 32
ENCRYPTION_KEY=""

# Erststart-Admin: wird nur angelegt, wenn noch kein Benutzer existiert.
# Nach dem ersten Login sollte das Passwort im UI geändert werden.
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD=""

# --- TLS / Erreichbarkeit ---------------------------------------------------

# Adresse, unter der MineControl erreichbar ist (steuert Caddys Auto-HTTPS):
#   localhost        → interne CA, Selbstsigniert (LAN/Test, Browser-Warnung)
#   mc.example.com   → automatisches Let's-Encrypt-Zertifikat (Port 80/443
#                      müssen aus dem Internet erreichbar sein)
MC_SITE_ADDRESS="localhost"

# Origin für CORS. Bei gleicher Herkunft (Standard, alles hinter Caddy)
# unkritisch; auf die tatsächliche URL setzen, wenn abweichend.
MC_WEB_ORIGIN="https://localhost"

# --- Optional ---------------------------------------------------------------

# CurseForge-API-Key für Modpacks (TYPE=AUTO_CURSEFORGE). Leer = das
# itzg-Image nutzt seinen eingebauten Key (in der Regel ausreichend).
CF_API_KEY=""

# Obergrenzen (MB) für Server-Import bzw. Plugin-/Mod-Uploads.
IMPORT_MAX_MB=10240
MODS_MAX_MB=200

# Auto-Restart/Crash-Recovery: Grace-Zeit (min) bis zum Neustart eines
# hängenden Docker-Servers und maximale Versuche, bevor aufgegeben wird.
AUTO_RESTART_GRACE_MIN=5
AUTO_RESTART_MAX_ATTEMPTS=3
