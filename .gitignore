# Abhängigkeiten
node_modules/

# Build-Ausgaben
dist/
build/
*.tsbuildinfo

# Umgebungsvariablen & Secrets
.env
.env.*
!.env.example

# Datenbank (SQLite, lokal)
*.db
*.db-journal

# Logs & Betriebsdaten
logs/
*.log

# Server-Backups (Laufzeitdaten) — verankert, damit die Regel nicht das
# Quellmodul apps/server/src/modules/backups/ mitschluckt.
/backups/
/apps/server/backups/

# Server-Import-Archive (Laufzeitdaten)
/imports/
/apps/server/imports/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Claude Code: persönliche/maschinenlokale Dateien (settings.json ohne
# .local dürfte man bewusst als Team-Config committen — nur das Lokale raus).
.claude/settings.local.json
.claude/*.lock

# Interne Planungs-/Arbeitsdokumente (nicht im öffentlichen Repo gewünscht,
# lokal erhalten). Bewusst per git rm --cached entfernt.
/PLANNING.md
/TESTPLAN.md
