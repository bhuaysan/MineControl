// MineControl — Datenmodell (siehe PLANNING.md §4)
// Phase 1 nutzt User, Server und AuditLog; die übrigen Modelle sind für
// spätere Phasen vorbereitet, damit Migrationen früh stabil sind.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  MODERATOR
  ADMIN
}

enum ServerType {
  DOCKER
  EXTERNAL
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         Role       @default(VIEWER)
  createdAt    DateTime   @default(now())
  // 2FA (TOTP) — Secret verschlüsselt; erst nach Bestätigung aktiv.
  totpSecretEnc String?
  totpEnabled   Boolean   @default(false)
  auditLogs    AuditLog[]
  apiTokens    ApiToken[]
}

// API-Token für Automatisierung (Bearer-Auth). Nur der Hash wird gespeichert.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  prefix     String
  role       Role
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
}

model Server {
  id                String     @id @default(cuid())
  name              String
  type              ServerType
  edition           String     @default("UNKNOWN")
  host              String
  port              Int        @default(25565)
  // RCON — Passwort verschlüsselt (nicht gehasht, wird zur Laufzeit gebraucht)
  rconPort          Int?
  rconPasswordEnc   String?
  // Docker (Phase 2)
  dockerContainerId String?
  dockerConfig      String? // JSON
  // Netzwerk (Phase 4 — Velocity): Zugehörigkeit als Subserver hinter einem Proxy.
  networkId         String?
  network           Network?   @relation("NetworkMembers", fields: [networkId], references: [id], onDelete: SetNull)
  networkAlias      String? // Name, unter dem der Proxy diesen Subserver kennt (z. B. „lobby")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  auditLogs AuditLog[]
  sessions  PlayerSession[]
  metrics   MetricSample[]
  backups   Backup[]
  tasks     ScheduledTask[]
  proxyOf   Network?        @relation("NetworkProxy")
}

// Phase 4 — Velocity-Netzwerk: ein Proxy-Server + N Subserver als Gruppe.
model Network {
  id                  String   @id @default(cuid())
  name                String
  // Der Velocity-Proxy (eigener Server-Datensatz, type DOCKER, edition VELOCITY).
  proxyServer         Server   @relation("NetworkProxy", fields: [proxyServerId], references: [id], onDelete: Cascade)
  proxyServerId       String   @unique
  // Modern-Forwarding-Secret (verschlüsselt) — Proxy und alle Subserver teilen es.
  forwardingSecretEnc String
  // Name des user-defined Docker-Bridge-Netzwerks.
  dockerNetworkName   String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members Server[] @relation("NetworkMembers")
}

// Phase 3 — Betrieb & Komfort

model MetricSample {
  id            String   @id @default(cuid())
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId      String
  timestamp     DateTime @default(now())
  playersOnline Int      @default(0)
  cpuPercent    Float?
  ramUsedMb     Int?
  ramMaxMb      Int?
  tps           Float?

  @@index([serverId, timestamp])
}

model Backup {
  id        String   @id @default(cuid())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  path      String
  sizeBytes Float    @default(0)
  trigger   String   @default("MANUAL") // MANUAL | SCHEDULED
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
}

model ScheduledTask {
  id        String    @id @default(cuid())
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String
  name      String
  cron      String
  action    String // RESTART | COMMAND | BACKUP
  payload   String? // JSON: { command } bzw. { retention }
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  lastError String?
  createdAt DateTime  @default(now())
}

// Generische App-Einstellungen (z. B. Discord-Webhook).
model Setting {
  key   String @id
  value String
}

model Player {
  uuid          String          @id
  lastKnownName String
  firstSeen     DateTime        @default(now())
  lastSeen      DateTime        @default(now())
  notes         String?
  sessions      PlayerSession[]
}

model PlayerSession {
  id       String    @id @default(cuid())
  player   Player    @relation(fields: [playerId], references: [uuid])
  playerId String
  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  server    Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  serverId  String?
  action    String
  details   String? // JSON
  timestamp DateTime @default(now())

  @@index([timestamp])
}
