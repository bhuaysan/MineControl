{
  "name": "@minecontrol/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --conditions development src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/websocket": "^11.1.0",
    "@minecontrol/shared": "workspace:*",
    "@prisma/client": "^6.3.1",
    "argon2": "^0.41.1",
    "dockerode": "^5.0.1",
    "fastify": "^5.2.1",
    "node-cron": "^4.6.0",
    "rcon-client": "^4.2.5",
    "tar-stream": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@types/tar-stream": "^3.1.4",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
